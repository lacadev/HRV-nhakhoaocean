{%- assign webfont_title = settings.base_font_title | split : ':' | first -%}
$colorBg: {{settings.shop_color_bg}};
$colorMain: {{settings.shop_main_color}};
$colorMain2: {{settings.shop_main_color_2}};
$colorText: {{settings.shop_text_color}};
$bgService: {{settings.service_2_bg}};
[class^="section-service-"] {
	padding: 80px 0;
}
@media(max-width: 767px){
	[class^="section-service-"] {
		padding: 40px 0;
	}
}
@keyframes progress {
	0% { --percentage: 0; }
	100% { --percentage: var(--value); }
}

@property --percentage {
	syntax: '<number>';
	inherits: true;
	initial-value: 0;
}

.section-service-1{
	position: relative;
	background-image: url({{ 'service_1_bg_img.jpg' | asset_url}});
	background-size: cover;
	background-position: center;
	background-attachment: fixed;
	padding: 150px 0;
	&:before{
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba($colorBg,0.8);
	}
	.heading-title{
		padding-bottom: 30px;
		border-bottom: 1px solid var(--shop-color-border);
	}
	.list-service{position: relative;}
	.row{gap: 40px 0;}
	.service-item {
		display: flex;
		gap: 20px;
		.item-img{flex: 0 0 50px;}
		.item-detail{
			.title{font-size: 22px;}
		}
	}
	@media(max-width: 991px){
		.heading-title{
			text-align: center;
			padding-bottom: 10px;
		}
	}
	@media(max-width: 767px){
		padding: 40px 0;
		.row{gap: 10px 0;}
		.service-item {
			.item-detail {
				.title{font-size: 16px;}
			}
		}
	}
}
.section-service-counter{
	.counter-item{
		text-align: center;
		.item-num {
			position: relative;
			.item-icon{
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				height: 100%;
				img{max-width: 50px;}
			}
		}
		.item-detail{
			font-weight: 600;
			.num {
				font-size: 35px;
				margin: 20px 0 15px;
				color: var(--shop-color-main-2);
			}
			.title{
				font-size: 20px;
				font-family: "{{ webfont_title }}", sans-serif;
				margin: 0;
			}
		}
	}
	.list-desc {
		.desc-item{
			&:first-child{
				font-size: 22px;
				text-align: center;
				padding: 30px;
				position: relative;
				&:before, &:after{
					content: '';
					position: absolute;
					left: 25%;
					width: 50%;
					height: 2px;
					background: var(--shop-color-main-2); 
				}
				&:before{
					top: 0;
				}
				&:after{
					bottom: 0;
				}
			}
		}
	}
	.row-counter{
		margin-top: 50px;
		padding-top: 50px;
		border-top: 1px solid var(--shop-color-border);
	}
	.progressbar {
		--percentage: var(--value);
		--primary: var(--shop-color-main);
		--secondary: #e7e7e7;
		--size: 180px;
		width: var(--size);
		aspect-ratio: 1;
		border-radius: 50%;
		position: relative;
		overflow: hidden;
		display: grid;
		place-items: center;
		margin: 0 auto;
		&.show-progress{
			animation: progress 2s 0.5s forwards;
		}
	}

	.progressbar::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: conic-gradient(var(--primary) calc(var(--percentage) * 1%), var(--secondary) 0);
		mask: radial-gradient(white 55%, transparent 0);
		mask-mode: alpha;
		-webkit-mask: radial-gradient(transparent 65%, #000 0);
		-webkit-mask-mode: alpha;
	}
	@media(min-width: 1200px){
		.list-desc {
			.desc-item{
				padding: 0 30px;
			}
		}
	}
	@media(max-width: 991px){
		.heading-title{text-align: center;}
		.row-counter, .list-desc{gap: 30px 0;}
		.counter-item {
			.item-detail {
				.num{margin: 5px 0 0px;}
			}
		}
		.list-desc {
			.desc-item{
				text-align: center;
			}
		}
	}
	@media(max-width: 767px){
		.progressbar{
			--size: 120px;
		}
		.counter-item {
			.item-num {
				.item-icon {
					img{max-width: 40px;}
				}
			}
			.item-detail{
				.num{font-size: 28px;}
				.title{font-size: 16px;}
			}
		}
		.list-desc {
			.desc-item{
				&:first-child{
					font-size: 18px;
					padding: 20px;
				}
			}
		}
	}
}
.section-service-review{
	position: relative;
	background-image: url({{ 'service_review_img.jpg' | asset_url}});
	background-size: cover;
	background-position: center;
	.review-item{
		position: relative;
		padding: 20px;
		background: var(--shop-color-bg);
		box-shadow: 0 10px 15px rgba(0, 0, 0, 0.15);
		margin: 30px 0 50px;
		&:before{
			content: '';
			position: absolute;
			top: 30px;
			right: 30px;
			width: 50px;
			height: 50px;
			background-image: url({{'img-quote.png' | asset_url}});
			background-size: contain;
			background-position: center;
			background-repeat: no-repeat;
		}
		.item-top {
			display: flex;
			align-items: center;
			gap: 15px;
			.item-img {
				flex: 0 0 50px;
				img{border-radius: 50%;}
			}
			.item-info{
				p{margin: 0;}
				.name {
					font-size: 18px;
					font-family: "{{ webfont_title }}", sans-serif;
					font-weight: 600;
				}
			}
		}
		.item-bottom {
			margin-top: 20px;
		}
	}
	.owl-dots{
		position: absolute;
		right: 0;
		bottom: 0;
		text-align: center;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 8px;
		width: 100%;
		.owl-dot {
			&{margin: 0 3px;outline:0;position: relative;width: 16px;height: 16px;} 
			span {
				&:before, &:after{
					content: '';
					position: absolute;
				}
				&:before{
					top: 7px;
					display: flex;display: -ms-flex;display: -webkit-flex;
					width: 16px;	height: 2px;
					background: #b1b1b1;
					transition: all 0.4s;
				}
				&:after{
					top: 0;
					left: 0;
					width: 16px;height: 16px;
					background: var(--shop-color-main-2);
					transition: 250ms ease all;
					transform: scale(0);
				}
			}
			/*&.active {
			border-radius: 50%;
			border: 2px solid #000000;
		}*/
			&.active span {
				&:after{
					transform: scale(1);
				}
			}
		}
	}
	.btn-more{
		.button:before{
			background-color: var(--shop-color-main-2);
		}
	}
	.btn-mb{display: none;}
	@media(max-width: 991px){
		.heading-title{text-align: center;}
		.review-item{
			margin: 15px 20px 50px
		}
		.btn-mb{display: block;}
		.btn-pc{display: none;}
		.btn-more{
			margin-top: 30px;
		}
	}
	@media(max-width: 767px){
		.review-item{
			margin: 10px 20px 30px;
			padding: 15px;
			.item-top {
				.item-info {
					.name{font-size: 16px;}
				}
			}
		}
	}
}
.section-service-2{
	background: rgba($colorMain2, 0.06);
	.btn-more{text-align: center;}
	.service-item{
		display: block;height: 100%;background: $bgService;
		.item-img{
			position: relative;
			.banner {
				position: relative;
				&:before {
					content: '';
					position: absolute;
					top: 0;
					left: 0;
					width: 100%;
					height: 100%;
					background: rgba(255, 255, 255, 0.3);
					transition: all 0.5s;
					opacity: 0;
				}
			}
			.icon{
				position: absolute;
				bottom: -42px;
				left: 30px;
				img{
					max-height: 85px;
					box-shadow: 0 2px 10px rgba(0,0,0,.2);
				}
			}
			&:hover{
				.banner {
					&:before {opacity: 1;}
				}
			}
		}
		.item-detail {
			padding: 60px 30px 30px;
			color: #fff;
			.title {
				font-size: 25px;
			}
			.desc{margin: 0;}
		}

	}
	.btn-mb{display: none;}
	@media(max-width: 991px){
		.btn-mb{display: block;margin-top: 30px;}
		.btn-pc{display: none;}
		.heading-title{text-align: center;}
		.list-service{gap: 20px 0;}
	}
	@media(max-width: 767px){
		.service-item{
			.item-img {
				.icon {
					bottom: -35px;
					img{max-height: 70px;}
				}
			}
			.item-detail{
				padding: 50px 30px 30px;
				.title{font-size: 18px;}
			}
		}
	}
}
