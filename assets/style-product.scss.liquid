{%- assign webfont_title = settings.base_font_title | split : ':' | first -%}
$colorBg: {{settings.shop_color_bg}};
$colorMain: {{settings.shop_main_color}};
$colorMain2: {{settings.shop_main_color_2}};
$colorText: {{settings.shop_text_color}};
.wrapper_layered_filter {
	border: 8px solid rgba($colorMain2, 0.2);
	padding: 10px 25px;
	.filter_group{
		padding: 15px 0;
		.filter_group_block{
			position: relative;
			/*border-top: 1px solid #333;*/
		}
		.filter_group-subtitle{
			position: relative;
			font-size: 18px;
			font-family: "{{ webfont_title }}", sans-serif;
			font-weight: 600;
			text-transform: uppercase;
			margin-bottom: 10px;
			padding: 0 0 10px;
			border-bottom: 1px solid var(--shop-color-border);
			color: var(--shop-color-main-2);
			&:before{
				content: '';
				position: absolute;
				top: 10px;
				right: 3px;
				width: 15px;
				height: 15px;
				background-image: url({{ 'icon-plus.png' | asset_url}});
				background-size: contain;
				background-repeat: no-repeat;
				transition: all 0.3s;
			}
			&[aria-expanded="true"]{
				&:before{background-image: url({{ 'icon-minus.png' | asset_url}});}
			}
		}

		.filter_group-subtitle:after {
			content: " ";
			position: absolute;top: 0;bottom: 0;right: 13px;margin: auto;
			height: 8px;
			width: 8px;
			border-color: #666;
			border-style: solid;
			border-width: 0 1px 1px 0;
			transform: translateY(-50%) rotate(45deg);
			transition: transform .2s ease;
			display: none;
		}
		.filter_group-subtitle.action-group:after {
			transform: translateY(-50%) rotate(225deg);
			bottom: -10px;
		}
		.filter_group-content{padding: 15px 0;}
	}
	.tree-menu li a {
		padding: 5px 5px 5px 0;
		color: #666;
		line-height: 26px; 
		font-size: 12px;
	}
	.tree-menu > li > a {
		color: var(--shop-text-color);
		font-weight: 500;
		font-size: 14px;
		line-height: 28px;
		letter-spacing: 1px;
	}
	.tree-menu li.has-child ul {display: none;}
	.tree-menu li.has-child:first-child ul {display: block;}
	.tree-menu li.has-child > ul {padding-left: 15px;}
	.tree-menu li a .icon-control {
		font-size:8px;
		position:relative;
		top: -2px;
	}
	.sidebar-collection{
		.pro-item{padding: 5px 0;
			&:not(:last-child){
				border-bottom: 1px solid var(--shop-color-border);
			}
		}
		.product-loop-small-sidebar {
			margin-bottom: 0;
			.product-inner {
				gap: 10px;
				.proloop-image{flex: 0 0 80px;border-radius: 0;}
				.proloop-detail {
					.detail-title {
						flex-flow: column;
						h3{font-size: 14px;margin-bottom: 5px;}
						.title-line{display: none;}
						.wrapper-action-loop .proloop--price {
							.price{font-size: 13px;}
							.price-del{font-size: 11px;}
						}
					}
					.proloop-desc{display: none;}
				}
			}
		}
	}
}
/* Layout product */
.productDetail--box [class^="product-"],.coupon-initial .listCoupon{background: transparent;}
.coupon-initial .listCoupon{
	gap: 15px 0;
}
.productDetail_style__01 {
	.productDetail--main {
		display: flex;
		display: -ms-flex;
		flex-wrap: wrap;
		-ms-flex-wrap: wrap;
	}
	.productDetail--gallery {
		position: relative;
		.productGallery_slider, .wrapbox-image.no_gallery{
			border: 1px solid var(--shop-color-border);
		}
		.productCarousel-thumb{margin: 15px 0 0;}
	}
	.productDetail--gallery .productList-slider .product-gallery img {
		cursor: url('https://file.hstatic.net/1000397797/file/cursor-zoom-in_67804ceaaa0941cf840b0ad13cde42ed.svg')
			, auto;
		overflow: hidden;
		-webkit-transition: all 300ms linear;
		-moz-transition: all 300ms linear;
		-ms-transition: all 300ms linear;
		-o-transition: all 300ms linear;
		transition: all 300ms linear;
	}
	.productDetail--gallery .productList-slider .owl-dots {
		display: none;
	}
	.productDetail--content {
		.wrapbox-detail {
			background: transparent;
		}
		.product-price{
			border-top: 1px solid var(--shop-color-border);
			border-radius: 0;
			.pro-title{display: none;}
		}
		.short-desc{padding-bottom: 15px;}
		.product-variants{
			padding: 0;
			&.check-action-variant:before{left: -10px;}
		}
		.product-actions {
			.select-actions {
				.addcart-area {
					gap: 10px;margin: 0;
					.quantity-area {
						box-shadow: 1px 1px 3px 1px rgba(34, 34, 34, 0.2);
						border-radius: 5px;
						width: 100px;
						.quantity-input{
							border: none;
							width: 100%;
						}
					}
					.btn-addtocart{
						border-color: var(--shop-color-main-2);
						color: #fff;
						padding: 15px 30px;
						width: auto;
						&:before{
							background-color: var(--shop-color-main-2);

						}
						&:hover{
							border-color: var(--shop-color-main);
						}
					}
				}
			}
		}
	}
	&.productDetail-information{
		.box-title h2{text-transform: unset;
			&:before{
				height: 2px;
				background: var(--shop-color-main-2);
				bottom: -12px;
			}
		}
		.product-toshare{
			padding: 0;
			margin: 30px 0;
			width: 100%;
			justify-content: end;
			.pro-title{display: none;}
		}
	}
	.productDetail-related,.productDetail-recently-viewed{
		padding: 40px 0 20px;
		h2{font-size: 24px;}
		.listProduct-row{
			&:not(.owl-loaded){
				overflow: hidden;
				.product-loop{
					-ms-flex: 0 0 33.33%;
					flex: 0 0 33.33%;
					max-width: 33.33%;
				}
			}
		}
	}
	@media(min-width: 992px) {
		margin-top: 50px;

		.product-container-gallery {
			padding: 15px 15px 15px 0;
		}
		.productDetail--box .product-description,
		.productDetail--box .product-coupon,
		.productDetail--box .product-question {
			padding: 0;
			margin-top: 30px
		}
		.productDetail--content .wrapbox-detail {
			padding-right: 0;
		}

		.productDetail--gallery {
			width: 45%
		}
		.productDetail--content {
			width: 55%;
			/*.product-heading, .product-price, .addcart-area{
			padding: 15px 15px 0;
		}*/
		}
		.productCarousel-slider:not(.owl-loaded) .product-gallery {
			flex: 0 0 100%;
			-ms-flex: 0 0 100%;
			max-width: 100%;
		}
		.productCarousel-thumb:not(.owl-loaded) .product-thumb {
			flex: 0 0 calc((100% - 75px) / 3);
			max-width: calc((100% - 75px) / 3);
			margin-right: 15px;
		}
		.product-deliverly {
			border-radius: 4px;
			border: 1px solid #eee;
			margin-bottom: 20px;
			margin-left: 0;
			margin-right: 0;
			padding-top: 15px;
		};


		/*
		.combo-info--vertical {
		.combo-info--content {display: flex;justify-content: space-between;flex-wrap: wrap;}
		.combo-content--name {flex: 0 0 100%;max-width: 100%;}
		.combo-content--total {flex: unset;}
		.combo-item {flex: 0 0 24%;max-width: 24%;}
		.combo-item--images a {border: 1px solid #dfdfdf;width: 150px;}
		.combo-item:not(:last-child) .combo-item--images:before {left: 150px;}
		.combo-content--total {border-top:0;border-left: 1px dashed #ddd;padding-top: 0;padding-left: 30px;}
		.combo-content--total .wrapbox-total {flex-direction: column;justify-content: center;align-items: flex-start;}
		.combo-content--total .wrapbox-total .combo-total {margin-bottom: 10px;margin-right: 0;}
	}
		*/
	}
	@media(max-width: 991px) {
		margin-top: 15px;
		.productDetail--box [class^="product-"]{padding: 0;}
		.content-mb{margin: 0;}
		.productDetail--main {
			display: block;
		}
		.productCarousel-thumb:not(.owl-loaded) .product-thumb {
			flex: 0 0 calc((100% - 60px) / 3);
			max-width: calc((100% - 60px) / 3);
			margin-right: 15px;
		}
		.wrapbox-right .wrapbox-detail {
			padding: 0;
		}
		.wrapbox-right .product-banner {
			margin-bottom: 0;
		}
		.wrapper_layered_filter{margin-bottom: 20px;border-width: 4px;padding: 0 15px;}
		.productDetail--content .wrapbox-detail{padding: 0;}
		.productDetail-related,.productDetail-recently-viewed{
			padding: 20px 0;
			h2{font-size: 20px;}
			.owlCarousel-style.owl-carousel .owl-nav .owl-prev, .owlCarousel-style.owl-carousel .owl-nav .owl-next{top: -45px;}
		}
	}
}

.list-faqs {
	max-width: 840px;
	font-size: 15px;
	.faq-item {
		margin-bottom: 20px;
	}
	.header-faqs {
		font-weight: 600;
		padding-right: 20px;
		padding-bottom: 10px;
		margin-bottom: 10px;
		border-bottom: 1px dashed #eee;
		position: relative;
		cursor: pointer;
		&:before {
			content: "";
			right: 5px;
			top: 12px;
			position: absolute;
			box-sizing: border-box;
			height: 8px;
			width: 8px;
			border-style: solid;
			border-color: currentColor;
			border-width: 0 1px 1px 0;
			transform: rotate(45deg);
			transition: border-width 150ms ease-in-out;
			transition: all 0.4s ease-in-out 0s;
			-moz-transition: all 0.4s ease-in-out 0s;
			-o-transition: all 0.4s ease-in-out 0s;
			-webkit-transition: all 0.4s ease-in-out 0s;
			-ms-transition: all 0.4s ease-in-out 0s;
		}
		&.opened {
			border-color: #000;
		}
		&.opened:before {
			-moz-transform: rotate(-135deg);
			-webkit-transform: rotate(-135deg);
			-o-transform: rotate(-135deg);
			-ms-transform: rotate(-135deg);
			transform: rotate(-135deg);
		}
	}
	.content-faqs {
		display: none;
	}
}
@media(min-width: 992px) {
	.layout-productDetail {
		margin-bottom: 55px
	}


	/*
	.layout-productDetail .productDetail_style__01 .productDetail--gallery{position: -webkit-sticky; position: sticky; top: 30px;}
	.layout-productDetail .productDetail_style__02 .productDetail--content{position: -webkit-sticky; position: sticky; top: 70px;}
	.layout-productDetail .productDetail_style__03 .productDetail--gallery{position: -webkit-sticky; position: sticky; top: 30px;}
	*/
	.stickyProduct-gallery,
	.stickyProduct-detail {
		top: 30px;
		position: -webkit-sticky;
		position: sticky;
		-webkit-transition: top 400ms ease;
		-moz-transition: top 400ms ease;
		transition: top 400ms ease;
	}
	body.scroll-body-up .stickyProduct-gallery,
	body.scroll-body-up .stickyProduct-detail {
		top: 80px;
	}
}
@media(max-width: 991px) {
	.productDetail-toolbar {
		border-top: 1px solid var(--shop-color-border);
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 999;
		background: #fff;
		margin: auto;
		padding: 7px 0;
		-webkit-transition: padding 0.3s ease;
		transition: padding 0.3s ease;
	}
}
