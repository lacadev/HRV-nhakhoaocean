{%- assign webfont_title = settings.base_font_title | split : ':' | first -%}
$colorBg: {{settings.shop_color_bg}};
$colorMain: {{settings.shop_main_color}};
$colorMain2: {{settings.shop_main_color_2}};
$colorText: {{settings.shop_text_color}};
[class^="section-contact"] {
	padding: 80px 0;
}
@media(max-width: 767px){
	[class^="section-contact"] {
		padding: 40px 0;
	}
}

.section-breadcrumb{
	position: relative;
	padding: 70px 0;
	background-image: var(--bg-breadcrumb);
	background-size: cover;
	background-position: center;
	background-attachment: fixed;
	color: #fff;
	&:before{
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba($colorMain, 0.8);
	}
	.breadcrumb-shop{border: none;background: transparent;position: relative;}
	.breadcrumb-list {
		.breadcrumb-arrows {
			> li + li{
				position: relative;
				padding-left: 20px;
				&:before{
					content: "\f111";
					position: absolute;
					top: 10px;
					left: 0;
					font-size: 5px;
				}
			}
			a{color: #fff;
				&:hover{
					color: var(--shop-color-hover);
				}
			}
		}
	}
	.breadcrumb-content{
		position: relative;
		.title{
			font-size: 38px;
			padding-bottom: 15px;
			position: relative;
			&:before{
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				width: 80px;
				height: 3px;
				background: var(--shop-color-main-2);
			}
		}
		.desc{max-width: 760px;}
	}
	@media(min-width: 1200px){
		.breadcrumb-list {
			.breadcrumb-arrows {
				> li {
					font-size: 17px;
				}
			}
		}
		.breadcrumb-content{
			.desc{font-size: 17px;}
		}
	}
	@media(max-width: 991px){
		text-align: center;
		.breadcrumb-list .breadcrumb-arrows{justify-content: center;}
		.breadcrumb-content .title:before {
			left: calc(50% - 40px);
		}
	}
	@media(max-width: 767px){
		padding: 40px 0;
		.breadcrumb-content{
			.title{font-size: 26px;}
		}
	}
}
.section-contact{
	.heading-title{
		.title2{
			span{color: var(--shop-color-main-2);}
		}
	}
	.contact-list{
		margin-top: 40px;
		.contact-item{
			.item-img{
				margin-bottom: 10px;
				img{max-height: 75px;}
			}
			.title{font-size: 22px;font-family: "{{ webfont_title }}", sans-serif;font-weight: 600;}
			.desc{color: rgba($colorText, 0.8);}
		}
	}
	@media(max-width: 991px){
		.contact-list{
			gap: 20px 0;
		}
	}
	@media(max-width: 767px){
		.contact-list .contact-item .title{font-size: 18px;}
	}
}
.section-contact-form{
	padding: 0;background: rgba($colorMain, 0.08);
	.form-booking{
		.contact-form{
			.input-group {
				margin-bottom: 20px;
				label{
					span{color: red;}
				}
				input{
					box-shadow: 1px 1px 3px 1px rgba(34, 34, 34, 0.08);
					border-radius: 5px;
					height: 52px;
					&::placeholder{opacity: 0;}
				}
			}
			.addcart-area{text-align: center;
				.button:before{background-color: var(--shop-color-main-2);}
			}
		}
	}
	.form-right{
		background: var(--shop-color-bg);
	}
	@media(min-width: 992px){
		.form-booking{
			.contact-form{
				.row>div{
					&:nth-child(odd){
						padding-right: 6px;
					}
					&:nth-child(even){
						padding-left: 6px;
					}
				}
			}
		}
		.form-left{
			padding: 0;
		}
		.form-right{
			padding: 50px 40px;
			display: flex;
			flex-flow: column;
			justify-content: center;
			.heading-title{
				.title1{font-size: 20px;}
				.title2{font-size: 40px;}
			}
		}
	}
	@media(max-width: 991px){
		.heading-title{text-align: center;}
		.form-left{padding: 0;}
		.form-right{
			padding: 30px 15px;
		}
	}
	@media(max-width: 767px){
		.form-booking{
			.contact-form{
				.input-group {
					input{
						height: 45px;
						font-size: 14px;
					}
				}
			}
		}
	}
}
.section-contact-partner{
	.list-logo {
		display: flex;
		flex-flow: wrap;
		gap: 15px;
		.logo-item{
			-ms-flex: 0 0 calc(100%/3 - 10px);
			flex: 0 0 calc(100%/3 - 10px);
			max-width: calc(100%/3 - 10px);
		}
	}
	@media(max-width: 767px){
		.list-logo {
			gap: 10px;
			.logo-item{
				-ms-flex: 0 0 calc(100%/2 - 5px);
				flex: 0 0 calc(100%/2 - 5px);
				max-width: calc(100%/2 - 5px);
			}
		}
	}
}
.section-contact-map{
	padding: 0;
	.contact-time{
		background: var(--shop-color-main);
		color: #fff;
		padding: 30px;
		position: relative;
		z-index: 1;
		p.title{font-size: 30px;font-family: "{{ webfont_title }}", sans-serif;font-weight: 600;}
		.list-time{
			li{
				padding: 8px 0;
				display: flex;
				justify-content: space-between;
				&:not(:last-child){
					border-bottom: 1px solid rgba(255,255,255,0.1);
				}
				.desc{color: rgba(255,255,255,0.5);}
			}
		}
		.btn-more {
			margin-top: 30px;
			.button{
				color: var(--shop-color-main-2);
				&:before{background-color: #fff;}
				&:hover{
					color: #fff;
				}
			}
		}

	}
	@media(min-width: 992px){
		.contact-top{
			flex-flow: nowrap;
			.top-left{
				-ms-flex: 0 0 75%;
				flex: 0 0 75%;
				max-width: 75%;
				margin-left: -8%;
			}

		}
	}
	@media(max-width: 991px){
		.contact-time{
			.title, .desc, .btn-more{text-align: center;}
		}
	}
	@media(max-width: 767px){
		.contact-time{
			p.title{font-size: 20px;}
		}
	}
}
