<div class="layout-about-us">
	{%if settings.show_about%}
	<section class="section-about-us {%if settings.show_about_service%}has-service{%endif%}">
		<div class="container">
			<div class="heading-title">
				{%if settings.about_title_1 != ''%}<p class="title1">{{settings.about_title_1}}</p>{%endif%}
				{%if settings.about_title_2 != ''%}<h2 class="title2">{{settings.about_title_2}}</h2>{%endif%}
			</div>
			<div class="row">
				<div class="col-lg-4 col-12">
					<div class="about-desc">
						{{settings.about_desc_1 | newline_to_br}}
					</div>
				</div>
				<div class="col-lg-4 col-12">
					<div class="about-desc">
						{{settings.about_desc_2 | newline_to_br}}
					</div>
				</div>
				<div class="col-lg-4 col-12">
					<div class="list-progress">
						{%- for i in (1..4) -%}
						{%- capture show -%}show_about_{{i}}{%- endcapture -%}
						{%- capture title -%}about_{{i}}_counter_title{%- endcapture -%}
						{%- capture text -%}about_{{i}}_counter_num{%- endcapture -%}
						{%- if settings[show] -%}
						<div class="jet-progress-bar" data-percent="{{settings[text]}}">
							<div class="jet-progress-bar__inner">
								<div class="jet-progress-bar__title">
									<span class="jet-progress-bar__title-text">{{settings[title]}}</span>
								</div>
								<div class="jet-progress-bar__wrapper">
									<div class="jet-progress-bar__status-bar">
										<div class="jet-progress-bar__percent">
											<span class="jet-progress-bar__percent-value">{{settings[text]}}</span>
											<span class="jet-progress-bar__percent-suffix">%</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						{%- endif -%}
						{%- endfor -%}
					</div>
				</div>
			</div>
		</div>
	</section>
	{%endif%}
	{%if settings.show_about_service%}
	<section class="section-about-service {%if settings.show_about%}has-about{%endif%}">
		<div class="container">
			<div class="row list-service">
				{%assign time1 = 0.3%}
				{%for i in (1..4)%}
				{%capture show%}show_about_service_{{i}}{%endcapture%}
				{%capture banner%}about_service_{{i}}_img_1.jpg{%endcapture%}
				{%capture icon%}about_service_{{i}}_img_2.jpg{%endcapture%}
				{%capture title%}about_service_{{i}}_title{%endcapture%}
				{%capture desc%}about_service_{{i}}_desc{%endcapture%}
				{%capture link%}about_service_{{i}}_link{%endcapture%}
				{%if settings[show]%}
				{%assign time1 = time1 | plus: 0.2%}
				<div class="col-lg-3 col-md-6 col-12 wow fadeInUp" data-wow-delay="{{time1}}s">
					<a href="{{settings[link]}}" class="service-item">
						<div class="item-img">
							<div class="banner">
								<img src="{{ banner | asset_url}}" alt="{{settings[title]}}"/>
							</div>
							<div class="icon">
								<img src="{{ icon | asset_url}}" alt="{{settings[title]}} icon"/>
							</div>
						</div>
						<div class="item-detail">
							{%if settings[title] != ''%}<h3 class="title">{{settings[title]}}</h3>{%endif%}
							{%if settings[desc] != ''%}<p class="desc">{{settings[desc]}}</p>{%endif%}
						</div>
					</a>
				</div>
				{%endif%}
				{%endfor%}
			</div>
		</div>
	</section>
	{%endif%}
	{%if settings.show_about_counter%}
	<section class="section-about-counter">
		<div class="container">
			<div class="row">
				<div class="col-lg-6 col-12">
					<div class="heading-title">
						{%if settings.about_counter_title_1 != ''%}<p class="title1">{{settings.about_counter_title_1}}</p>{%endif%}
						{%if settings.about_counter_title_2 != ''%}<h2 class="title2">{{settings.about_counter_title_2}}</h2>{%endif%}
						{%if settings.about_counter_desc != ''%}<p class="desc">{{settings.about_counter_desc}}</p>{%endif%}
					</div>
				</div>
			</div>
			<div class="row row-counter">
				{%assign time2 = 0.2%}
				{%for i in (1..4)%}
				{%capture show%}show_about_counter_{{i}}{%endcapture%}
				{%capture img%}about_counter_{{i}}_img.jpg{%endcapture%}
				{%capture title%}about_counter_{{i}}_title{%endcapture%}
				{%capture num%}about_counter_{{i}}_num{%endcapture%}
				{%if settings[show]%}
				{%assign time2 = time2 | plus: 0.1%}
				<div class="col-lg-3 col-md-6 col-12 wow fadeInUp" data-wow-delay="{{time2}}s">
					<div class="counter-item">
						<div class="item-num">
							<div aria-valuenow="{{settings[num]}}" aria-valuemin="0" aria-valuemax="100" style="--value: {{settings[num]}}" class="progressbar"></div>
							<div class="item-icon">
								<img src="{{ img | asset_url}}" alt="{{settings[title]}}" />
							</div>
						</div>
						<div class="item-detail">
							<p class="num">{{settings[num]}}%</p>
							<p class="title">{{settings[title]}}</p>
						</div>
					</div>
				</div>
				{%endif%}
				{%endfor%}
			</div>
			<div class="row list-desc">
				{%assign time3 = 0.3%}
				{%for i in (1..3)%}
				{%capture desc%}about_counter_desc_{{i}}{%endcapture%}
				{%if settings[desc] != ''%}
				{%assign time3 = time3 | plus: 0.2%}
				<div class="col-lg-4 col-12 desc-item wow fadeInUp" data-wow-delay="{{time3}}s">
					{{settings[desc] | newline_to_br}}
				</div>
				{%endif%}
				{%endfor%}
			</div>
		</div>
	</section>
	{%endif%}
	{%if settings.show_about_review%}
	<section class="section-about-review">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-lg-9 col-12">
					<div class="heading-title">
						{%if settings.about_review_title_1 != ''%}<p class="title1">{{settings.about_review_title_1}}</p>{%endif%}
						{%if settings.about_review_title_2 != ''%}<h2 class="title2">{{settings.about_review_title_2}}</h2>{%endif%}
					</div>
				</div>
				{%if settings.about_review_btn != ''%}
				<div class="col-lg-3 col-12 btn-pc">
					<div class="btn-more text-right">
						<a href="{{settings.about_review_link}}" class="button">{{settings.about_review_btn}}</a>
					</div>
				</div>
				{%endif%}
			</div>
			<div class="list-review owl-carousel">
				{%for i in (1..10)%}
				{%capture show%}show_about_review_{{i}}{%endcapture%}
				{%capture img%}about_review_{{i}}_img.jpg{%endcapture%}
				{%capture name%}about_review_{{i}}_name{%endcapture%}
				{%capture position%}about_review_{{i}}_position{%endcapture%}
				{%capture desc%}about_review_{{i}}_desc{%endcapture%}
				{%if settings[show]%}
				<div class="review-item">
					<div class="item-top">
						<div class="item-img">
							<img src="{{ img | asset_url}}" alt="{{settings[name]}}" />
						</div>
						<div class="item-info">
							<p class="name">{{settings[name]}}</p>
							<p class="position">{{settings[position]}}</p>
						</div>
					</div>
					<div class="item-bottom">
						{{settings[desc]}}
					</div>
				</div>
				{%endif%}
				{%endfor%}
			</div>
			{%if settings.about_review_btn != ''%}
			<div class="btn-more btn-mb text-center">
				<a href="{{settings.about_review_link}}" class="button">{{settings.about_review_btn}}</a>
			</div>
			{%endif%}
		</div>
	</section>
	{%endif%}
	{%if settings.show_about_form%}
	<section class="section-about-form">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-lg-6 offset-lg-6 col-12">
					<div class="heading-title">
						{%if settings.about_form_title_1 != ''%}<p class="title1">{{settings.about_form_title_1}}</p>{%endif%}
						{%if settings.about_form_title_2 != ''%}<h2 class="title2">{{settings.about_form_title_2}}</h2>{%endif%}
						{%if settings.about_form_desc != ''%}<p class="desc">{{settings.about_form_desc}}</p>{%endif%}
					</div>
					<div class="form-booking">
						<form id="form-booking-3" class="formbooking" action="{{settings.about_gg_link_form}}" data-shop="{{shop.name}}" data-form="{{settings.form_about_booking}}" data-harasocial="{{settings.about_form_harasocial_link}}" data-success="{{ settings.about_form_success | newline_to_br}}">
							<div class="contact-form">
								<div class="row">
									<div class="col-md-6 col-12">
										<div class="input-group">
											<label for="full_name">{{settings.about_form_name}} <span>*</span></label>
											<input required type="text" name="{{settings.about_gg_name}}" id="full_name" data-valid="full_name"  class="form-control" placeholder="{{settings.about_form_name}}" aria-describedby="basic-addon1">
										</div>
										<p class="full_name-validation field-error"></p>
									</div>
									<div class="col-md-6 col-12">
										<div class="input-group">
											<label for="your_phone">{{settings.about_form_phone}} <span>*</span></label>
											<input pattern="[0-9]{10,12}" required type="text" name="{{settings.about_gg_phone}}" id="your_phone" data-valid="your_phone" class="form-control" placeholder="{{settings.about_form_phone}}" aria-describedby="basic-addon1">
										</div>
										<p class="your_phone-validation field-error"></p>
									</div>
									<div class="col-md-6 col-12">
										<div class="input-group">
											<label for="your_email">{{settings.about_form_email}}</label>
											<input required type="text" name="{{settings.about_gg_email}}" id="your_email" data-valid="your_email" class="form-control" placeholder="{{settings.about_form_email}}" aria-describedby="basic-addon1">
										</div>
										<p class="your_email-validation field-error"></p>
									</div>
									<div class="col-md-6 col-12">
										<div class="input-group">
											<label for="your_date">{{settings.about_form_date}}</label>
											<input required type="date" name="{{settings.about_gg_date}}" id="your_date" data-valid="your_date"  class="form-control" placeholder="{{settings.about_form_date}}" aria-describedby="basic-addon1">
										</div>
										<p class="your_date-validation field-error"></p>
									</div>
									<div class="col-md-12 col-12">
										<div class="addcart-area">						
											<button type="button" class="button btn-send"> 
												{{settings.about_form_booking}}
											</button>
										</div>
									</div>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</section>
	{%endif%}
	{%if settings.show_about_time%}
	<section class="section-about-contact">
		<div class="row align-items-center contact-top">
			<div class="col-lg-8 col-12 top-left">
				<div class="contact-map">
					{{settings.about_contact_map}}
				</div>
			</div>
			<div class="col-lg-4 col-12">
				<div class="contact-time">
					{%if settings.about_contact_time_title != ''%}<p class="title">{{settings.about_contact_time_title}}</p>{%endif%}
					{%if settings.about_contact_time_desc != ''%}<p class="desc">{{settings.about_contact_time_desc}}</p>{%endif%}
					<ul class="list-time">
						{%for i in (1..6)%}
						{%capture title%}about_contact_time_{{i}}_title{%endcapture%}
						{%capture desc%}about_contact_time_{{i}}_desc{%endcapture%}
						{%if settings[title] != ''%}
						<li>
							<span class="title">{{settings[title]}}</span>
							<span class="desc">{{settings[desc]}}</span>
						</li>
						{%endif%}
						{%endfor%}
					</ul>
					{%if settings.about_contact_btn != ''%}
					<div class="btn-more">
						<a href="{{settings.about_contact_link}}" class="button">{{settings.about_contact_btn}}</a>
					</div>
					{%endif%}
				</div>
			</div>
		</div>
	</section>
	{%endif%}
</div>

